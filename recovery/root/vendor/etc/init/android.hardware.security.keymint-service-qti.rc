# Started by override-spl.sh once ro.build.version.release and the patch
# levels match the installed system/vendor, so KeyMint never sees TWRP's
# placeholder version and asks to upgrade (rewrite) the user's keys.

service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    class early_hal
    disabled
    user system
    group system drmrpc
    seclabel u:r:recovery:s0

on property:vendor.car.hiber=hiberExit
    stop vendor.keymint-qti
    start vendor.keymint-qti
    stop keystore2
    start keystore2
